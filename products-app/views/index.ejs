<!DOCTYPE html>
<html>

<head>
    <title>Product Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body class="bg-light">

    <div class="container mt-5">

        <h2 class="text-center mb-4">Product Management</h2>

        <% if (success) { %>
            <div class="alert alert-success">
                <%= success %>
            </div>
            <% } %>

                <% if (error) { %>
                    <div class="alert alert-danger">
                        <%= error %>
                    </div>
                    <% } %>

                        <div class="card p-4 shadow">

                            <div class="d-flex justify-content-between mb-3">

                                <form action="/search" class="d-flex">
                                    <input class="form-control me-2" name="keyword" placeholder="Search product" value="<%= keyword || " " %>">
                                    <button class="btn btn-primary">Search</button>
                                </form>

                                <a href="/add" class="btn btn-success">Add Product</a>
                            </div>

                            <table class="table table-bordered table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Name</th>
                                        <th>Image</th>
                                        <th>Price</th>
                                        <th>Quantity</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!products || products.length === 0) { %>
                                        <tr>
                                            <td colspan="5" class="text-center">No products found.</td>
                                        </tr>
                                        <% } %>

                                            <% products.forEach(p => { %>
                                                <tr>
                                                    <td>
                                                        <%= p.name %>
                                                    </td>
                                                    <td>
                                                        <img src="<%= p.image || 'https://via.placeholder.com/100?text=No+Image' %>" width="100" class="rounded" onerror="this.src='https://via.placeholder.com/100?text=No+Image'">
                                                    </td>
                                                    <td>$
                                                        <%= p.price %>
                                                    </td>
                                                    <td>
                                                        <%= p.quantity %>
                                                    </td>
                                                    <td>
                                                        <a href="/edit/<%= p.ID %>" class="btn btn-warning btn-sm">Edit</a>
                                                        <a href="/delete/<%= p.ID %>" class="btn btn-danger btn-sm" onclick="return confirm('Delete this product?')">Delete</a>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                </tbody>
                            </table>

                            <% if (totalPages > 1) { %>
                                <nav>
                                    <ul class="pagination justify-content-center">
                                        <% for (let p = 1; p <= totalPages; p++) { %>
                                            <li class="page-item <%= p === page ? 'active' : '' %>">
                                                <a class="page-link" href="/?keyword=<%= encodeURIComponent(keyword || '') %>&page=<%= p %>&limit=<%= limit %>">
                                                    <%= p %>
                                                </a>
                                            </li>
                                            <% } %>
                                    </ul>
                                </nav>
                                <% } %>

                        </div>

    </div>

</body>

</html>