<!DOCTYPE html>
<html>

<head>
    <title>Edit Product</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body class="bg-light">

    <div class="container mt-5">

        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-warning text-dark text-center">
                        <h4>Edit Product</h4>
                    </div>
                    <div class="card-body">
                        <% if (error) { %>
                            <div class="alert alert-danger">
                                <%= error %>
                            </div>
                            <% } %>

                                <form action="/edit/<%= product.ID %>" method="POST" enctype="multipart/form-data">
                                    <div class="mb-3">
                                        <label class="form-label">Product Name</label>
                                        <input class="form-control" name="name" value="<%= product.name || " " %>" required>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Price</label>
                                        <input type="number" class="form-control" name="price" value="<%= product.price || " " %>" required>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Quantity</label>
                                        <input type="number" class="form-control" name="quantity" value="<%= product.quantity || " " %>" required>
                                    </div>

                                    <div class="mb-3 text-center">
                                        <label class="form-label">Current Image</label><br>
                                        <img src="<%= product.image || 'https://via.placeholder.com/150?text=No+Image' %>" width="150" class="rounded" onerror="this.src='https://via.placeholder.com/150?text=No+Image'">
                                    </div>

                                    <input type="hidden" name="oldImage" value="<%= product.image || " " %>">

                                    <div class="mb-3">
                                        <label class="form-label">Upload New Image (optional)</label>
                                        <input type="file" class="form-control" name="image">
                                    </div>

                                    <button class="btn btn-warning w-100">Update Product</button>
                                </form>
                    </div>
                </div>
            </div>
        </div>

    </div>

</body>

</html>