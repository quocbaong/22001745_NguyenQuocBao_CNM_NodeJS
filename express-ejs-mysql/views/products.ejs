<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Product List</title>
</head>

<body>
    <h2>Add Product</h2>
    <form action="/add" method="post">
        Name: <input name="name"><br> Price: <input name="price"><br> Quantity: <input name="quantity"><br>
        <button style="background-color: rgb(114, 204, 240);">Add</button>
    </form>

    <h2>Products</h2>
    <table border="1">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Action</th>
        </tr>
        <% products.forEach(p => { %>
            <tr>
                <td>
                    <%= p.id %>
                </td>
                <td>
                    <%= p.name %>
                </td>
                <td>
                    <%= p.price %>
                </td>
                <td>
                    <%= p.quantity %>
                </td>
                <td>
                    <a href="/edit/<%= p.id %>">Edit</a>
                    <form action="/delete/<%= p.id %>" method="post" onsubmit="return confirm('Delete this product?')">
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
            <% }) %>
    </table>
</body>

</html>