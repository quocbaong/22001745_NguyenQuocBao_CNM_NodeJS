<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Management</title>
    <style>
            * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
            background: #ffffff;
            color: #333;
            line-height: 1.6;
            min-height: 100vh;
        }
        
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 20px;
        }
        
        header {
            text-align: center;
            padding: 40px 20px 30px;
            background: linear-gradient(135deg, #1976d2 0%, #1565c0 100%);
            color: white;
            border-radius: 10px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(25, 118, 210, 0.2);
        }
        
        header h1 {
            font-size: 2em;
            font-weight: 300;
            letter-spacing: -0.5px;
            margin-bottom: 5px;
        }
        
        header p {
            font-size: 0.9em;
            color: rgba(255, 255, 255, 0.9);
        }
        
        .section {
            background: white;
            margin-bottom: 30px;
            padding: 25px;
            border-radius: 8px;
            border-left: 4px solid #1976d2;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }
        
        .section h2 {
            font-size: 1.3em;
            font-weight: 500;
            margin-bottom: 20px;
            color: #1976d2;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 12px;
            margin-bottom: 15px;
        }
        
        input {
            padding: 10px 12px;
            border: 2px solid #e0e0e0;
            border-radius: 6px;
            font-size: 0.95em;
            font-family: inherit;
            transition: all 0.2s;
        }
        
        input:focus {
            outline: none;
            border-color: #1976d2;
            box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.1);
        }
        
        input::placeholder {
            color: #999;
        }
        
        button {
            padding: 10px 20px;
            border: none;
            background: linear-gradient(135deg, #1976d2 0%, #1565c0 100%);
            color: white;
            font-size: 0.95em;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            font-family: inherit;
            border-radius: 6px;
        }
        
        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(25, 118, 210, 0.3);
        }
        
        .search-form {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }
        
        .search-form input {
            flex: 1;
            min-width: 250px;
        }
        
        .clear-link {
            padding: 10px 20px;
            background: #f0f0f0;
            color: #1976d2;
            text-decoration: none;
            font-size: 0.95em;
            transition: all 0.2s;
            border: 1px solid #ddd;
            display: inline-block;
            border-radius: 6px;
            font-weight: 500;
        }
        
        .clear-link:hover {
            background: #e3f2fd;
            border-color: #1976d2;
        }
        
        .table-responsive {
            overflow-x: auto;
            margin: 0 -25px -25px -25px;
            padding: 0 25px 25px 25px;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.95em;
        }
        
        th {
            padding: 12px;
            text-align: left;
            font-weight: 600;
            background: linear-gradient(135deg, #1976d2 0%, #1565c0 100%);
            color: white;
            border-bottom: 2px solid #1976d2;
        }
        
        td {
            padding: 12px;
            border-bottom: 1px solid #eee;
        }
        
        tr:hover {
            background: #e3f2fd;
        }
        
        .action-cell {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }
        
        .action-cell form {
            margin: 0;
        }
        
        .btn-edit {
            padding: 8px 12px;
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
            text-decoration: none;
            font-size: 0.9em;
            font-weight: 500;
            display: inline-block;
            transition: all 0.2s;
            border: none;
            cursor: pointer;
            font-family: inherit;
            border-radius: 5px;
        }
        
        .btn-edit:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(40, 167, 69, 0.3);
        }
        
        .btn-delete {
            padding: 8px 12px;
            background: linear-gradient(135deg, #dc3545 0%, #e74c3c 100%);
            color: white;
            font-size: 0.9em;
            font-weight: 500;
            transition: all 0.2s;
            border-radius: 5px;
        }
        
        .btn-delete:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(220, 53, 69, 0.3);
            .empty-state {
                text-align: center;
                padding: 50px 20px;
                color: #999;
            }
            .empty-state p {
                font-size: 1em;
            }
            @media (max-width: 768px) {
                .container {
                    padding: 15px;
                }
                .section {
                    padding: 15px;
                }
                header h1 {
                    font-size: 1.6em;
                }
                .form-row {
                    grid-template-columns: 1fr;
                }
                .search-form {
                    flex-direction: column;
                }
                .search-form input {
                    min-width: 100%;
                }
                .action-cell {
                    flex-direction: column;
                    gap: 6px;
                }
                .btn-edit,
                .btn-delete {
                    width: 100%;
                    text-align: center;
                }
            }
    </style>
</head>

<body>
    <div class="container">

        <div class="section">
            <h2>Add New Product</h2>
            <form action="/add" method="post">
                <div class="form-row">
                    <input type="text" name="name" placeholder="Product Name" required>
                    <input type="number" name="price" placeholder="Price" step="0.01" required>
                    <input type="number" name="quantity" placeholder="Quantity" required>
                </div>
                <button type="submit">Add Product</button>
            </form>
        </div>

        <div class="section">
            <h2>Search Products</h2>
            <form method="get" action="/" class="search-form">
                <input type="text" name="q" placeholder="Enter product name..." value="<%= keyword %>">
                <button type="submit">Search</button>
                <% if (keyword) { %>
                    <a href="/" class="clear-link">Clear</a>
                    <% } %>
            </form>
        </div>

        <div class="section">
            <h2>Product List</h2>
            <% if (products && products.length > 0) { %>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% products.forEach(p => { %>
                                <tr>
                                    <td>
                                        <%= p.id %>
                                    </td>
                                    <td>
                                        <%= p.name %>
                                    </td>
                                    <td>$
                                        <%= parseFloat(p.price).toFixed(2) %>
                                    </td>
                                    <td>
                                        <%= p.quantity %>
                                    </td>
                                    <td>
                                        <div class="action-cell">
                                            <a href="/edit/<%= p.id %>" class="btn-edit">Edit</a>
                                            <form action="/delete/<%= p.id %>" method="post" onsubmit="return confirm('Delete this product?');" style="margin: 0;">
                                                <button type="submit" class="btn-delete">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                    <div class="empty-state">
                        <p>No products found. Add a new product to get started!</p>
                    </div>
                    <% } %>
        </div>
    </div>
</body>

</html>