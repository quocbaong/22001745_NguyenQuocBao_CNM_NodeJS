<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Edit Product</title>
</head>

<body>

    <h2>Edit Product</h2>

    <form action="/edit/<%= product.id %>" method="post">
        Name:
        <input name="name" value="<%= product.name %>" required>
        <br> Price:
        <input name="price" value="<%= product.price %>" required>
        <br> Quantity:
        <input name="quantity" value="<%= product.quantity %>" required>
        <br>

        <button type="submit">Update</button>
    </form>

    <br>
    <a href="/">Back</a>

</body>

</html>