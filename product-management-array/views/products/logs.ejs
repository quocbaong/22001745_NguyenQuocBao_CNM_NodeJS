<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lịch sử sản phẩm</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            background: #f8f9fa;
        }
        
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        
        .log-card {
            background: white;
            border-left: 4px solid #667eea;
            border-radius: 5px;
            margin-bottom: 15px;
            padding: 15px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
        }
        
        .log-action {
            font-weight: bold;
            display: inline-block;
            padding: 5px 10px;
            border-radius: 5px;
            margin-bottom: 10px;
        }
        
        .log-action.CREATE {
            background: #d4edda;
            color: #155724;
        }
        
        .log-action.UPDATE {
            background: #cce5ff;
            color: #004085;
        }
        
        .log-action.DELETE {
            background: #f8d7da;
            color: #721c24;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/">📦 Product Management</a>
            <a href="/logout" class="btn btn-light btn-sm">Đăng xuất</a>
        </div>
    </nav>

    <div class="container py-5">
        <div class="mb-4">
            <a href="/" class="btn btn-secondary">← Quay lại</a>
            <h1 class="d-inline-block ms-3">📝 Lịch sử sản phẩm:
                <%= product.name %>
            </h1>
        </div>

        <% if (logs.length === 0) { %>
            <div class="alert alert-info" role="alert">
                ℹ️ Chưa có lịch sử thao tác cho sản phẩm này
            </div>
            <% } else { %>
                <div class="row">
                    <div class="col-md-8">
                        <% logs.forEach(log => { %>
                            <div class="log-card">
                                <div class="log-action <%= log.action %>">
                                    <% if (log.action === 'CREATE') { %>
                                        ✅ THÊM MỚI
                                        <% } else if (log.action === 'UPDATE') { %>
                                            🔄 CẬP NHẬT
                                            <% } else if (log.action === 'DELETE') { %>
                                                🗑️ XOÁ
                                                <% } %>
                                </div>
                                <p class="mb-2">
                                    <strong>👤 Người thực hiện:</strong>
                                    <%= log.userId %>
                                </p>
                                <p class="mb-0 text-muted">
                                    <strong>⏰ Thời gian:</strong>
                                    <%= new Date(log.time).toLocaleString('vi-VN') %>
                                </p>
                            </div>
                            <% }); %>
                    </div>
                </div>
                <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>