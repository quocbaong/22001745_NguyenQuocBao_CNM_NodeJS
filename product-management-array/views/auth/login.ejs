<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - Product Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        .login-card {
            width: 100%;
            max-width: 400px;
            border-radius: 10px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        }
        
        .login-card .card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 10px 10px 0 0;
            padding: 30px 0;
        }
        
        .login-card h2 {
            text-align: center;
            margin: 0;
            font-weight: bold;
        }
        
        .form-group {
            margin-bottom: 15px;
        }
        
        .btn-login {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
            font-weight: bold;
            padding: 10px;
        }
        
        .btn-login:hover {
            background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
            color: white;
        }
        
        .error-alert {
            margin-bottom: 20px;
        }
        
        .demo-info {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            margin-top: 20px;
        }
        
        .demo-info h5 {
            margin-bottom: 10px;
            font-weight: bold;
        }
        
        .demo-info p {
            margin: 5px 0;
            font-size: 14px;
        }
        
        .demo-info code {
            background: white;
            padding: 2px 6px;
            border-radius: 3px;
            font-family: monospace;
        }
    </style>
</head>

<body>
    <div class="login-card card">
        <div class="card-header">
            <h2>🔐 Đăng nhập</h2>
        </div>
        <div class="card-body p-4">
            <% if (error) { %>
                <div class="alert alert-danger alert-dismissible fade show error-alert" role="alert">
                    <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>

                    <form method="POST" action="/login">
                        <div class="form-group">
                            <label for="username" class="form-label">👤 Username</label>
                            <input type="text" class="form-control form-control-lg" id="username" name="username" required placeholder="Nhập username">
                        </div>

                        <div class="form-group">
                            <label for="password" class="form-label">🔑 Password</label>
                            <input type="password" class="form-control form-control-lg" id="password" name="password" required placeholder="Nhập password">
                        </div>

                        <button type="submit" class="btn btn-login btn-lg w-100">Đăng nhập</button>
                    </form>

                    <!-- Demo Credentials -->
                    <div class="demo-info">
                        <h5>📝 Tài khoản demo:</h5>
                        <p><strong>Admin:</strong> <code>admin</code> / <code>admin123</code></p>
                        <p><strong>Staff:</strong> <code>staff</code> / <code>staff123</code></p>
                        <p><small>👉 Admin: Quản lý sản phẩm & danh mục</small></p>
                        <p><small>👉 Staff: Chỉ xem danh sách</small></p>
                    </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>