<%- include('partials/header') %>

    <section class="card">
        <h1 class="heading">Thêm sản phẩm</h1>

        <form action="/add" method="POST" enctype="multipart/form-data" onsubmit="return validateForm()">
            <div class="form-grid">
                <div class="form-group">
                    <label for="name">Tên sản phẩm</label>
                    <input id="name" type="text" name="name" required placeholder="Nhập tên sản phẩm" />
                </div>

                <div class="form-group">
                    <label for="price">Giá (VNĐ)</label>
                    <input id="price" type="number" name="price" step="1000" min="0" required placeholder="Nhập giá" />
                </div>

                <div class="form-group">
                    <label for="unit_in_stock">Số lượng tồn kho</label>
                    <input id="unit_in_stock" type="number" name="unit_in_stock" min="0" required placeholder="Nhập số lượng" />
                </div>

                <div class="form-group">
                    <label for="image">Ảnh sản phẩm</label>
                    <input id="image" type="file" name="image" accept="image/*" required />
                </div>
            </div>

            <div style="margin-top: 2rem; text-align: center;">
                <button class="btn" type="submit">Lưu</button>
                <a class="btn btn--secondary" href="/">Hủy</a>
            </div>
        </form>
    </section>
    </main>
    </body>
    <script>
        function validateForm() {
            const name = document.getElementById('name').value.trim();
            if (!name) {
                alert('Tên sản phẩm không được để trống');
                return false;
            }
            const price = parseFloat(document.getElementById('price').value);
            if (isNaN(price) || price <= 0) {
                alert('Giá phải là số dương');
                return false;
            }
            const stock = parseInt(document.getElementById('unit_in_stock').value);
            if (isNaN(stock) || stock < 0) {
                alert('Số lượng phải là số không âm');
                return false;
            }
            const image = document.getElementById('image').files[0];
            if (!image) {
                alert('Vui lòng chọn ảnh');
                return false;
            }
            return true;
        }
    </script>

    </html>