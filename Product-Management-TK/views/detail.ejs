<%- include('partials/header') %>

    <section class="card">
        <h1 class="heading">Chi tiết sản phẩm</h1>

        <div class="form-grid" style="max-width: 600px; margin: 0 auto;">
            <div class="form-group">
                <label>Tên sản phẩm</label>
                <div><strong><%= product.name %></strong></div>
            </div>

            <div class="form-group">
                <label>Giá</label>
                <div>
                    <%= product.price.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' }) %>
                </div>
            </div>

            <div class="form-group">
                <label>Số lượng tồn kho</label>
                <div>
                    <%= product.unit_in_stock %>
                </div>
            </div>

            <div class="form-group">
                <label>Ảnh sản phẩm</label>
                <img class="image-preview" src="<%= product.url_image %>" alt="<%= product.name %>" />
            </div>
        </div>

        <div style="margin-top: 2rem; text-align: center;">
            <a class="btn btn--secondary" href="/">Quay lại</a>
            <a class="btn" href="/edit/<%= product.id %>">Chỉnh sửa</a>
        </div>
    </section>
    </main>
    </body>

    </html>