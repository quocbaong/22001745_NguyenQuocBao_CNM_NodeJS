<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit Product</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
      <div class="container">
        <a class="navbar-brand" href="/products">Product Manager</a>
      </div>
    </nav>

    <div class="container">
      <div class="card shadow-sm">
        <div class="card-body">
          <h2 class="h5 mb-3">Edit Product</h2>
          <form method="post" action="/products/edit/<%= product.id %>">
            <div class="mb-3">
              <label class="form-label">Name</label>
              <input name="name" value="<%= product.name %>" class="form-control" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Price</label>
              <input name="price" value="<%= product.price %>" class="form-control" type="number" step="0.01" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Image URL</label>
              <input name="url_image" value="<%= product.url_image %>" class="form-control" />
            </div>
            <div class="d-flex gap-2">
              <button class="btn btn-primary">Save</button>
              <a href="/products" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
