<%- include('partials/header') %>

<div class="card" style="max-width: 700px; margin: 0 auto;">
    <h1 class="heading">Thêm vé mới</h1>

    <% if (locals.errors && errors.length > 0) { %>
        <div class="errors">
            <ul style="margin: 0; padding-left: 1.25rem;">
                <% errors.forEach(err => { %> <li><%= err %></li> <% }); %>
            </ul>
        </div>
    <% } %>

    <form action="/add" method="POST" enctype="multipart/form-data">
        <div class="form-group">
            <label>Tên sự kiện</label>
            <input type="text" name="eventName" class="form-control" required value="<%= locals.data ? data.eventName : '' %>">
        </div>
        <div class="form-group">
            <label>Tên người sở hữu</label>
            <input type="text" name="holderName" class="form-control" required value="<%= locals.data ? data.holderName : '' %>">
        </div>
        
        <div class="form-grid">
            <div class="form-group">
                <label>Loại vé</label>
                <select name="category" class="form-control" required>
                    <option value="Standard" <%= locals.data && data.category === 'Standard' ? 'selected' : '' %>>Standard</option>
                    <option value="VIP" <%= locals.data && data.category === 'VIP' ? 'selected' : '' %>>VIP</option>
                    <option value="VVIP" <%= locals.data && data.category === 'VVIP' ? 'selected' : '' %>>VVIP</option>
                </select>
            </div>
            <div class="form-group">
                <label>Trạng thái</label>
                <select name="status" class="form-control" required>
                    <option value="Upcoming" <%= locals.data && data.status === 'Upcoming' ? 'selected' : '' %>>Upcoming</option>
                    <option value="Sold" <%= locals.data && data.status === 'Sold' ? 'selected' : '' %>>Sold</option>
                    <option value="Cancelled" <%= locals.data && data.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                </select>
            </div>
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label>Số lượng</label>
                <input type="number" name="quantity" class="form-control" required value="<%= locals.data ? data.quantity : '' %>">
            </div>
            <div class="form-group">
                <label>Giá vé ($)</label>
                <input type="number" step="0.01" name="pricePerTicket" class="form-control" required value="<%= locals.data ? data.pricePerTicket : '' %>">
            </div>
        </div>

        <div class="form-group">
            <label>Ngày diễn ra</label>
            <input type="date" name="eventDate" class="form-control" required value="<%= locals.data ? data.eventDate : '' %>">
        </div>

        <div class="form-group">
            <label>Ảnh minh họa / QR Code</label>
            <input type="file" name="image" class="form-control" accept="image/*">
        </div>

        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn btn-primary" style="flex: 2; padding: 0.75rem;">Lưu thông tin</button>
            <a href="/" class="btn btn-secondary" style="flex: 1; padding: 0.75rem; text-align: center;">Hủy</a>
        </div>
    </form>
</div>
</main>
</body>
</html>
