<%- include('partials/header') %>

<div class="card" style="max-width: 700px; margin: 0 auto;">
    <h1 class="heading">Chỉnh sửa thông tin vé</h1>

    <% if (locals.errors && errors.length > 0) { %>
        <div class="errors">
            <ul style="margin: 0; padding-left: 1.25rem;">
                <% errors.forEach(err => { %> <li><%= err %></li> <% }); %>
            </ul>
        </div>
    <% } %>

    <form action="/edit/<%= ticket.ticketId %>" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="currentImageUrl" value="<%= ticket.imageUrl %>">
        
        <div class="form-group">
            <label>Tên sự kiện</label>
            <input type="text" name="eventName" class="form-control" required value="<%= ticket.eventName %>">
        </div>
        <div class="form-group">
            <label>Tên người sở hữu</label>
            <input type="text" name="holderName" class="form-control" required value="<%= ticket.holderName %>">
        </div>
        
        <div class="form-grid">
            <div class="form-group">
                <label>Loại vé</label>
                <select name="category" class="form-control" required>
                    <option value="Standard" <%= ticket.category === 'Standard' ? 'selected' : '' %>>Standard</option>
                    <option value="VIP" <%= ticket.category === 'VIP' ? 'selected' : '' %>>VIP</option>
                    <option value="VVIP" <%= ticket.category === 'VVIP' ? 'selected' : '' %>>VVIP</option>
                </select>
            </div>
            <div class="form-group">
                <label>Trạng thái</label>
                <select name="status" class="form-control" required>
                    <option value="Upcoming" <%= ticket.status === 'Upcoming' ? 'selected' : '' %>>Upcoming</option>
                    <option value="Sold" <%= ticket.status === 'Sold' ? 'selected' : '' %>>Sold</option>
                    <option value="Cancelled" <%= ticket.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                </select>
            </div>
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label>Số lượng</label>
                <input type="number" name="quantity" class="form-control" required value="<%= ticket.quantity %>">
            </div>
            <div class="form-group">
                <label>Giá vé ($)</label>
                <input type="number" step="0.01" name="pricePerTicket" class="form-control" required value="<%= ticket.pricePerTicket %>">
            </div>
        </div>

        <div class="form-group">
            <label>Ngày diễn ra</label>
            <input type="date" name="eventDate" class="form-control" required value="<%= ticket.eventDate %>">
        </div>

        <div class="form-group">
            <label>Thay đổi ảnh (không chọn nếu giữ nguyên)</label>
            <input type="file" name="image" class="form-control" accept="image/*">
            <% if (ticket.imageUrl) { %>
                <div style="margin-top: 1rem;">
                    <p style="font-size: 0.875rem; color: #64748b;">Ảnh hiện tại:</p>
                    <img src="<%= ticket.imageUrl %>" style="width: 100px; border-radius: 8px; border: 1px solid #e2e8f0;">
                </div>
            <% } %>
        </div>

        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn btn-warning" style="flex: 2; padding: 0.75rem;">Cập nhật vé</button>
            <a href="/" class="btn btn-secondary" style="flex: 1; padding: 0.75rem; text-align: center;">Hủy</a>
        </div>
    </form>
</div>
</main>
</body>
</html>
